#!/usr/bin/env python3
# FAKE-HYPRCTL: mounted over /usr/bin/hyprctl inside the test sandbox (see
# sandbox.sh). Writes down what it was asked and answers from the fixtures. It
# opens no socket, so nothing a test does can reach a compositor through it.
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_HYPR_LOG"], "a") as f:
    f.write("hyprctl " + json.dumps(args) + "\n")
fx = json.load(open(os.environ["FAKE_HYPR_FIXTURES"]))
if os.path.exists(os.environ.get("FAKE_HYPR_FAIL_FILE", "/nonexistent")):
    sys.exit(3)


def one(req):
    # Each request of a batch comes clean, whichever side of "; " the j/ was put on:
    # -j's prefix goes on before the space after the semicolon is gone.
    req = req.strip()
    if req.startswith("j/"):
        req = req[2:].strip()
    if req.startswith("getoption "):
        name = req.split()[1]
        known = fx.get("options", {}).get(name)
        return json.dumps(known) if known else "no such option"
    if req.startswith("getprop "):
        _, window, prop = req.split()
        props = fx.get("getprop", {}).get(window.removeprefix("address:"))
        # A window that has closed answers in words, not JSON.
        return json.dumps({prop: props[prop]}) if props and prop in props else "window not found"
    return json.dumps(fx.get(req, []))


if "--batch" in args:
    prefix = "j/" if "-j" in args else ""
    print("\n\n\n".join(one(prefix + r) for r in args[args.index("--batch") + 1].split(";")))
else:
    print("ok")

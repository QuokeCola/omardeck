#!/bin/bash

# Drives the liquidglass Hyprland plugin for the bar panel.
#
#   glass-ctl status        prints "loaded=0|1 enabled=0|1"
#   glass-ctl on [so-path]  loads the plugin if needed, then enables it
#   glass-ctl off           disables it (the library stays loaded)
#
# Hyprland never really unloads a plugin's library, so a load always goes
# through a fresh copy in the runtime dir (same as the repo's `make reload`).

set -uo pipefail

so=${2:-$HOME/src/hypr-liquid-glass/liquidglass.so}
so=${so/#\~/$HOME}
rundir=${XDG_RUNTIME_DIR:-/tmp}

loaded() { hyprctl -j plugin list 2>/dev/null | grep -q '"name": "liquidglass"'; }

set_enabled() {
  hyprctl eval "hl.config({ plugin = { liquidglass = { enabled = $1 } } })" >/dev/null
  # Applies the blur size that goes with the state and repaints.
  hyprctl liquidglass >/dev/null
}

case ${1:-status} in
  status)
    if loaded; then
      enabled=$(hyprctl -j getoption plugin:liquidglass:enabled | grep -q '"bool": true' && echo 1 || echo 0)
      echo "loaded=1 enabled=$enabled"
    else
      echo "loaded=0 enabled=0"
    fi
    ;;
  on)
    if ! loaded; then
      [[ -r $so ]] || { echo "missing $so" >&2; exit 1; }
      copy=$rundir/liquidglass-$(date +%s%N).so
      cp "$so" "$copy" && hyprctl plugin load "$copy" >/dev/null || { rm -f "$copy"; exit 1; }
      echo "$copy" >"$rundir/liquidglass.loaded"
    fi
    set_enabled true
    ;;
  off)
    loaded && set_enabled false
    ;;
  *)
    echo "usage: glass-ctl status|on [so]|off" >&2
    exit 2
    ;;
esac
